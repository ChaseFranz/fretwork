# Copy to .env (gitignored, as is any .env.*) and fill in. Read by deploy.py only.
# Credentials do NOT go here - deploy.py refuses a file that contains any.
# Configure an AWS CLI profile or SSO login and name it below instead.
# For AWS_* keys the value here wins over one exported in your shell.
# Comments after a value are fine: KEY=value  # note

FRETWORK_BUCKET=my-bucket
# FRETWORK_DISTRIBUTION=E1ABC23DEF456
# FRETWORK_HEADER=Main
# FRETWORK_SITE_DIR=site/Main
# AWS_PROFILE=fretwork-deploy
# AWS_REGION=us-east-1
